# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
# These win over anything set on the Settings page -- see core/env.py for the
# precedence. Leave them out entirely if you would rather configure narration
# from the app.

# A free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model to ask. The Settings page has a "Which models?" button that
# asks your key what it can actually use, which beats guessing: identifiers
# change, and a wrong one fails with a 404 rather than a useful message.
GEMINI_MODEL=gemini-3.7-flash
